DJANGO_SECRET_KEY=CHANGE_ME
PUBLIC_HOSTNAME=
SENTRY_DSN=
SENTRY_ENV=
DB_NAME=postgres
DB_USER=postgres
DB_PASS=postgres
DB_SERVICE=db
DB_PORT=5432

# Set to true to redirect image requests directly to Scryfall's CDN instead of
# serving from R2. Simpler setup, but depends on Scryfall availability and ToS.
# Blurriness-based selection still works; images are just never stored in R2.
USE_SCRYFALL_REDIRECT=false

# Cloudflare R2 (optional — omit to use local media storage)
CLOUDFLARE_R2_ACCOUNT_ID=
CLOUDFLARE_R2_KEY_ID=
CLOUDFLARE_R2_SECRET=
CLOUDFLARE_R2_BUCKET=
CLOUDFLARE_R2_PUBLIC_DOMAIN=  # e.g. pub-xxx.r2.dev or your custom domain (no https://)